# Copy to .env (scripts/setup.sh does this for you and fills in the IDs).
USER_UID=1000
USER_GID=1000
VIDEO_GID=44
RENDER_GID=109

# Pin the base image by digest for fully reproducible builds, e.g.
# ROS_IMAGE=ros:jazzy@sha256:<digest>
ROS_IMAGE=ros:jazzy
IMETRO_TAG=latest
BUILD_JOBS=4
ROS_DOMAIN_ID=42

# Which compose files to layer. scripts/setup.sh writes this line for you.
COMPOSE_FILE=compose.yaml:compose.x11.yaml
